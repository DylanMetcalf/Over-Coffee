{
  "name": "over-coffee",
  "version": "0.3.0",
  "private": true,
  "description": "Over Coffee — a personal daily newspaper. Product prototype.",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning server/index.js",
    "dev": "node --no-warnings=ExperimentalWarning --watch server/index.js",
    "test": "node --no-warnings=ExperimentalWarning --test test/*.test.js",
    "qa": "node scripts/qa/launch-e2e.mjs",
    "previews": "node --no-warnings=ExperimentalWarning scripts/build-previews.js"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "*"
  },
  "dependencies": {
    "web-push": "^3.6.7"
  }
}
